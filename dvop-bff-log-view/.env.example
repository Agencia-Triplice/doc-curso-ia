# Configuração do dvop-bff-log-view (Node/NestJS) — chaves LOG_BFF_* (default entre parênteses)
LOG_BFF_DEFAULT_SRV_URL=http://dvop-srv-log-process:8000   # srv de logs (MS1) + link do front (default http://localhost:8000)
LOG_BFF_CACHE_URL=                # cache de soluções LEITURA (MS2/cache-query, réplica); vazio desabilita o hop no /api/diagnostico (vazio)
LOG_BFF_CACHE_WRITER_URL=         # store de ESCRITA (MS5/cache-writer); órfãos/rascunhos/prompts só existem aqui — o cockpit lê a cura/prompt do curador daqui (vazio = usa CACHE_URL, que devolve 404 nessas rotas)
LOG_BFF_RETRIEVAL_URL=            # base de conhecimento (MS3); vazio = cache-only (vazio)
LOG_BFF_REVIEW_URL=               # fila de curadoria (MS7); vazio = painel de curadoria off (vazio)
LOG_BFF_MCPGH_URL=                # mcp-github; vazio = /api/importar off (vazio)
LOG_BFF_MCPGH_TOKEN=              # token default do mcp-github (header X-GitHub-Token sobrepõe) (vazio) — NUNCA logar/commitar
LOG_BFF_AGENTIX_URL=              # endpoint GraphQL do Agentix; vazio = agente off (vazio)
LOG_BFF_AGENTIX_TOKEN=            # token estático do Agentix (alternativa ao client_credentials) (vazio) — NUNCA logar/commitar
LOG_BFF_AGENTIX_TOKEN_URL=        # token endpoint p/ client_credentials (vazio)
LOG_BFF_AGENTIX_CLIENT_ID=        # client_id (vazio)
LOG_BFF_AGENTIX_CLIENT_SECRET=    # client_secret — NUNCA logar/commitar (vazio)
LOG_BFF_AGENTIX_TENANT_ID=        # header x-lx-tenant (vazio)
LOG_BFF_AGENTIX_BUNDLE_NAME=dvop-agx-ssol-propor-solucao   # bundle do agente (default dvop-agx-ssol-propor-solucao)
LOG_BFF_AGENTIX_BUNDLE_VERSION=   # versão do bundle (vazio)
LOG_BFF_AGENTIX_ENTITY_ID=        # entityId (vazio)
LOG_BFF_AGENTIX_ENTITY_NAME=dvop-diagnostico   # entityName (default dvop-diagnostico)
LOG_BFF_AGENTIX_ENTITY_VERSION=1.0.0           # entityVersion (default 1.0.0)
LOG_BFF_AGENTIX_ENTITY_TYPE=GROUP              # entityType (default GROUP)
LOG_BFF_ALLOWED_HOSTS=            # CSV de hosts liberados no `src` (host ou host:porta); vazio = qualquer, OBRIGATÓRIO em prod (vazio)
LOG_BFF_CORS_ORIGINS=             # CSV de origins CORS; vazio = off (front same-origin) (vazio)
LOG_BFF_REQUEST_TIMEOUT=10        # timeout (s) das chamadas upstream (10)
LOG_BFF_LOG_LEVEL=INFO            # nível de log (INFO)
LOG_BFF_DB_PATH=/opt/app-root/src/data/requests.db   # SQLite do audit; em k8s no PVC (default ./data/requests.db)
LOG_BFF_AUDIT_MAX_ROWS=10000      # retenção do audit (10000)
LOG_BFF_MAX_BODY_BYTES=2097152    # teto do corpo cru → 413 acima disso (2 MiB)

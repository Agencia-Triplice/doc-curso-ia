# Configuração do dvop-bff-curadoria (Node/NestJS) — chaves CURADORIA_BFF_* (default entre parênteses)
CURADORIA_BFF_MS5_URL=http://localhost:8002   # cache-writer (MS 5): fila de órfãos + gravação de soluções — OBRIGATÓRIO (default http://localhost:8002)
CURADORIA_BFF_MS3_URL=                        # retrieval (MS 3): contexto p/ o prompt do Copilot; vazio = contexto desabilitado (vazio)
CURADORIA_BFF_MS8_URL=                        # catálogo de remediações (MS 8) p/ elegibilidade a PR; vazio = cadastro de elegibilidade desligado (vazio)
CURADORIA_BFF_ELEGIBILIDADE_DB_PATH=data/elegibilidade.db   # SQLite do vínculo erro→remediação (único estado local do bff-curadoria) (default data/elegibilidade.db)
CURADORIA_BFF_REQUEST_TIMEOUT=10              # timeout (s) das chamadas aos upstreams (10)
CURADORIA_BFF_LOG_LEVEL=INFO                  # nível de log (JSON estruturado) (INFO)
CURADORIA_BFF_MAX_BODY_BYTES=2097152          # teto do corpo cru da requisição em bytes; acima disso → 413 (2 MiB)

# --- Agentix (worker curador automático — MVP-2) ---
# vazio = worker desligado (zero custo de LLM); ver agentixConfigurado() em src/config/env.ts
CURADORIA_BFF_AGENTIX_URL=                    # URL do /graphql/ da plataforma; vazio = worker off (vazio)
CURADORIA_BFF_AGENTIX_TOKEN=                  # segredo — preencher em DEV/PRD (bearer estático; alternativa ao client_credentials) — NUNCA logar/commitar
CURADORIA_BFF_AGENTIX_TOKEN_URL=              # endpoint de token do Keycloak; configurado, tem precedência sobre o token estático (vazio)
CURADORIA_BFF_AGENTIX_CLIENT_ID=              # segredo — preencher em DEV/PRD (client_credentials)
CURADORIA_BFF_AGENTIX_CLIENT_SECRET=          # segredo — preencher em DEV/PRD (client_credentials) — NUNCA logar/commitar
CURADORIA_BFF_AGENTIX_TENANT_ID=              # segredo — preencher em DEV/PRD (header x-lx-tenant, credencial de serviço server-side)
CURADORIA_BFF_AGENTIX_BUNDLE_NAME=dvop-agx-ssol-propor-solucao   # bundle que contém o agente curador (default dvop-agx-ssol-propor-solucao)
CURADORIA_BFF_AGENTIX_BUNDLE_VERSION=         # versão do bundle gerada pela esteira (ex.: 0.0.15) (vazio)
CURADORIA_BFF_AGENTIX_ENTITY_ID=              # id do group dvop-curador no ambiente (confirmar na validação DEV) (vazio)
CURADORIA_BFF_AGENTIX_ENTITY_NAME=dvop-curador                  # nome da entidade invocada (default dvop-curador)
CURADORIA_BFF_AGENTIX_ENTITY_VERSION=1.0.0                      # versão da entidade invocada (default 1.0.0)
CURADORIA_BFF_AGENTIX_ENTITY_TYPE=GROUP                          # tipo da entidade invocada (default GROUP)

# --- Curador (loop do worker) ---
CURADORIA_BFF_CURADOR_INTERVALO=60           # segundos entre ciclos (backoff dobra até 600 quando o Agentix falha) (default 60)
CURADORIA_BFF_CURADOR_LOTE=2                 # máx. de órfãos processados por ciclo (protege cota do LiteLLM) (default 2)
CURADORIA_BFF_CURADOR_MAX_TENTATIVAS=3       # teto de tentativas de LLM por órfão (contadas em memória; badge "IA falhou" na fila) (default 3)

# --- Autenticação ---
# Segredo de assinatura do cookie de sessão (OBRIGATÓRIO em produção).
CURADORIA_BFF_SESSION_SECRET=
# Validade da sessão em segundos (default 43200 = 12h).
CURADORIA_BFF_SESSION_TTL_SECONDS=43200
# OAuth App do GitHub (deixe vazio para desabilitar o botão GitHub).
# A entrada por PAT continua disponível mesmo sem o OAuth configurado.
CURADORIA_BFF_GITHUB_CLIENT_ID=
CURADORIA_BFF_GITHUB_CLIENT_SECRET=
CURADORIA_BFF_GITHUB_CALLBACK_URL=
# Host do GitHub. Default = github.com. Para GitHub Enterprise Server (Bradesco),
# aponte BASE p/ https://<host> e API p/ https://<host>/api/v3 — o código não muda.
CURADORIA_BFF_GITHUB_BASE_URL=https://github.com
CURADORIA_BFF_GITHUB_API_URL=https://api.github.com
# Org cujos teams gateiam o acesso (default GDD-Core).
CURADORIA_BFF_GITHUB_ORG=GDD-Core
# Lista de teams (slugs, CSV) que podem acessar. Vazio = qualquer autenticado.
CURADORIA_BFF_GITHUB_ALLOWED_TEAMS=
# Dev bypass: injeta um usuário fake (só fora de produção). Vazio em produção.
CURADORIA_BFF_AUTH_DEV_USER=
